# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Portkey API key used to call OpenAI (gpt-5.6-luna by default)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# CHAT_MODEL=gpt-5.6-luna        # or gpt-6-astra (only these two are allowed)
# COOKIE_SECURE=1                # set when serving over HTTPS
